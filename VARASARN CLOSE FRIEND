                        <div class="col-4"><select class="form-select" id="filterSemester" onchange="renderReviews()"><option value="">ทุกเทอม</option><option value="1">เทอม 1</option><option value="2">เทอม 2</option><option value="ฤดูร้อน">ฤดูร้อน</option></select></div>
                        <div class="col-4"><select class="form-select" id="filterYear" onchange="renderReviews()"><option value="">ทุกปี</option><option value="2569">2569</option><option value="2568">2568</option><option value="2567">2567</option><option value="2566">2566</option><option value="2565">2565</option></select></div>
