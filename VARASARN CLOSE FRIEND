    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ==========================================
        // API URL ที่คุณได้มา ใส่ไว้ตรงนี้เรียบร้อยแล้วครับ ✅
        // ==========================================
        const API_URL = "https://script.google.com/macros/s/AKfycbxbk3B29ZWT4fO0GlJ6uZAKAdH5flxfGrQ6NSDCGJCMtdbITU56KPKGmiqvKvEziM0z/exec"; 

        let globalData = {};
        let courseModalInstance, reviewModalInstance;
        let currentCategoryFilter = 'ทั้งหมด';
        let currentUserEmail = "";

        window.onload = function() {
            courseModalInstance = new bootstrap.Modal(document.getElementById('courseModal'));
            reviewModalInstance = new bootstrap.Modal(document.getElementById('reviewModal'));
            
            // ระบบ Login ชั่วคราว (เก็บในเครื่อง)
            currentUserEmail = localStorage.getItem("varasarn_user_email");
            if (!currentUserEmail) {
                let inputEmail = prompt("ยินดีต้อนรับสู่ Varasarn Close Friends!\n\nกรุณากรอก Email ของคุณเพื่อเข้าใช้งาน:");
                if(inputEmail && inputEmail.trim() !== "") {
                    currentUserEmail = inputEmail.trim();
                    localStorage.setItem("varasarn_user_email", currentUserEmail);
                } else {
                    currentUserEmail = "guest@domain.com"; // ถ้าไม่กรอกให้เป็น Guest ไปก่อน
                }
            }

            // แสดงชื่อผู้ใช้
            let shortEmail = currentUserEmail.split('@')[0];
            document.getElementById('userEmailDisplay').innerHTML = `<i class="bi bi-person-circle me-1"></i>${shortEmail}`;
            document.getElementById('userEmailDisplayMobile').innerHTML = `<i class="bi bi-person-circle me-1"></i>${shortEmail}`;

            loadData();
        };

        // ====== ฟังก์ชันการเปลี่ยนหน้าเว็บ ======
        function showHomeView() {
            document.getElementById('timetableView').style.display = 'none';
            document.getElementById('myReviewsView').style.display = 'none';
            document.getElementById('homeView').style.display = 'block';
            window.scrollTo(0,0);
        }

        function showTimetableView() {
            document.getElementById('homeView').style.display = 'none';
            document.getElementById('myReviewsView').style.display = 'none';
            document.getElementById('timetableView').style.display = 'block';
            renderTimetablePage();
            window.scrollTo(0,0);
        }

        function showMyReviewsView() {
            document.getElementById('homeView').style.display = 'none';
            document.getElementById('timetableView').style.display = 'none';
            document.getElementById('myReviewsView').style.display = 'block';
            renderMyReviewsPage();
            window.scrollTo(0,0);
        }

        function handleLogout() {
            if(confirm("คุณต้องการออกจากระบบ (ล้างข้อมูล Email ในเครื่องนี้) ใช่หรือไม่?")) {
                localStorage.removeItem("varasarn_user_email");
                location.reload(); // รีเฟรชหน้าเว็บเพื่อเข้าสู่ระบบใหม่
            }
        }

        // ====== ฟังก์ชันดึงข้อมูลจาก API ======
        function loadData(callback) {
            if(Object.keys(globalData).length === 0) document.getElementById('loading').style.display = 'block';
            
            fetch(API_URL)
                .then(response => response.json())
                .then(data => {
                    globalData = data;
                    globalData.currentUser = currentUserEmail; // อัปเดต User ปัจจุบันเข้าไปใน Data

                    renderCourses(data.courses);
                    document.getElementById('loading').style.display = 'none';
                    filterCourses();
                    if(callback) callback();
                })
                .catch(error => {
                    alert("เกิดข้อผิดพลาดในการดึงข้อมูล กรุณาลองรีเฟรชหน้าเว็บใหม่ครับ");
                    console.error(error);
                    document.getElementById('loading').style.display = 'none';
                });
        }

        // ====== ฟังก์ชันส่งข้อมูลไปยัง API (POST Wrapper) ======
        function postDataToAPI(payload, successCallback, btnElement, btnOriginalText) {
            fetch(API_URL, {
                method: "POST",
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(result => {
                if(result.status === "success") {
                    successCallback(result);
                } else {
                    alert("เกิดข้อผิดพลาด: " + result.message);
                    if(btnElement) {
                        btnElement.disabled = false;
                        btnElement.innerHTML = btnOriginalText;
                    }
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ กรุณาลองใหม่อีกครั้ง");
                if(btnElement) {
                    btnElement.disabled = false;
                    btnElement.innerHTML = btnOriginalText;
                }
            });
        }

        // ====== ระบบจัดการรายวิชา (Courses) ======
        function filterByCategory(category, btnElement) {
            currentCategoryFilter = category;
            let btns = document.getElementsByClassName('category-btn');
            for(let i = 0; i < btns.length; i++) {
                btns[i].classList.remove('btn-purple');
                btns[i].classList.add('btn-outline-purple');
            }
            btnElement.classList.remove('btn-outline-purple');
            btnElement.classList.add('btn-purple');
            filterCourses();
        }

        function filterCourses() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let items = document.getElementsByClassName('course-item');
            for (let i = 0; i < items.length; i++) {
                let code = items[i].querySelector('.card-title').innerText.toLowerCase();
                let name = items[i].querySelector('.card-text').innerText.toLowerCase();
                let cardCategory = items[i].querySelector('.badge').innerText;
                
                let matchText = code.includes(input) || name.includes(input);
                let matchCategory = (currentCategoryFilter === 'ทั้งหมด') || cardCategory.includes(currentCategoryFilter.replace('ฯ', ''));
                
                items[i].style.display = (matchText && matchCategory) ? "" : "none";
            }
        }

        function renderCourses(courses) {
            let html = '';
            for (let i = 1; i < courses.length; i++) {
                if (!courses[i][0]) continue;
                let rowIndex = i + 1;
                let code = courses[i][0];
                let name = courses[i][1];
                let category = courses[i][2];
                let creatorEmail = courses[i][3] || "";
                
                let actionBtnsHtml = (creatorEmail === globalData.currentUser && globalData.currentUser !== "") 
                    ? `<button class="btn btn-sm text-secondary" title="แก้ไข" onclick="event.stopPropagation(); openEditCourseModal(${rowIndex}, '${code}', '${name}', '${category}')"><i class="bi bi-pencil-fill"></i></button>
                       <button class="btn btn-sm text-danger" title="ลบ" onclick="event.stopPropagation(); deleteData('Courses', ${rowIndex})"><i class="bi bi-trash-fill"></i></button>`
                    : '';
                    
                html += `<div class="col-md-4 mb-4 course-item"><div class="card course-card" onclick="openReviewModal('${code}', '${name}')"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="badge">${category}</span><div class="action-btns">${actionBtnsHtml}</div></div><h5 class="card-title text-purple fw-bold">${code}</h5><p class="card-text">${name}</p></div></div></div>`;
            }
            document.getElementById('courseList').innerHTML = html;
        }

        function openCourseModal() {
            document.getElementById('courseForm').reset();
            document.getElementById('courseRowIndex').value = "";
            courseModalInstance.show();
        }

        function openEditCourseModal(rowIndex, code, name, category) {
            document.getElementById('courseRowIndex').value = rowIndex;
            document.getElementById('newCourseCode').value = code;
            document.getElementById('newCourseName').value = name;
            document.getElementById('newCourseCategory').value = category;
            courseModalInstance.show();
        }

        function handleCourseSubmit(e) {
            e.preventDefault();
            let btn = document.getElementById('btnSubmitCourse');
            let originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = "กำลังบันทึก...";

            let payload = {
                action: document.getElementById('courseRowIndex').value ? "updateCourse" : "addCourse",
                rowIndex: document.getElementById('courseRowIndex').value,
                courseCode: document.getElementById('newCourseCode').value,
                courseName: document.getElementById('newCourseName').value,
                category: document.getElementById('newCourseCategory').value,
                userEmail: currentUserEmail
            };

            postDataToAPI(payload, function(result) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                courseModalInstance.hide();
                loadData();
            }, btn, originalText);
        }

        // ====== ระบบจัดการรีวิว (Reviews) ======
        function openReviewModal(code, name) {
            document.getElementById('reviewModalTitle').innerHTML = `<i class="bi bi-book-half me-2"></i>${code} - ${name}`;
            document.getElementById('reviewCourseCode').value = code;
            document.getElementById('reviewFormCollapse').classList.remove('show');
            renderReviews();
            reviewModalInstance.show();
        }

        function prepareNewReview() {
            document.getElementById('reviewForm').reset();
            document.getElementById('editReviewRowIndex').value = "";
            document.getElementById('btnCancelEditReview').style.display = "none";
            document.getElementById('reviewFormTitle').innerText = "✍️ เขียนรีวิว & ข้อมูลเวลาเรียน";
        }

        function renderReviews() {
            let code = document.getElementById('reviewCourseCode').value;
            let courseName = document.getElementById('reviewModalTitle').innerText.split(' - ')[1];
            let filterRating = document.getElementById('filterRating').value;
            let filterSemester = document.getElementById('filterSemester').value;
            let filterYear = document.getElementById('filterYear').value;
            
            let reviews = globalData.reviews;
            let reviewHtml = '';
            let hasReview = false;
            
            for (let i = reviews.length - 1; i >= 1; i--) {
                if (reviews[i][1] === code) {
                    let rating = reviews[i][2];
                    let text = reviews[i][3];
                    let semester = reviews[i][4] || "-";
                    let year = reviews[i][5] || "-";
                    let teacher = reviews[i][6] || "-";
                    let sec = reviews[i][7] || "-";
                    let day = reviews[i][8] || "-";
                    let start = reviews[i][9] || "-";
                    let end = reviews[i][10] || "-";
                    let creatorEmail = reviews[i][11] || "";
                    
                    if (filterRating && filterRating != rating) continue;
                    if (filterSemester && filterSemester != semester) continue;
                    if (filterYear && filterYear != year) continue;
                    
                    hasReview = true;
                    let rowIndex = i + 1;
                    let date = new Date(reviews[i][0]).toLocaleDateString('th-TH');
                    let stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
                    let safeText = text.replace(/`/g, '\\`').replace(/\n/g, '\\n');
                    
                    let actionBtnsHtml = (creatorEmail === globalData.currentUser && globalData.currentUser !== "") 
                        ? `<button class="btn btn-sm text-secondary px-1" title="แก้ไข" onclick="setupEditReview(${rowIndex}, ${rating}, \`${safeText}\`, '${semester}', '${year}', '${teacher}', '${sec}', '${day}', '${start}', '${end}')"><i class="bi bi-pencil-fill"></i></button>
                           <button class="btn btn-sm text-danger px-1" title="ลบ" onclick="deleteData('Reviews', ${rowIndex})"><i class="bi bi-trash-fill"></i></button>`
                        : '';
                        
                    reviewHtml += `
                    <div class="review-box">
                        <div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
                            <div class="d-flex align-items-center">
                                <span class="star-rating me-2">${stars}</span>
                                <span class="badge" style="background-color: var(--purple-100); color: var(--purple-700);">เทอม ${semester}/${year}</span>
                            </div>
                            <div class="d-flex align-items-center mt-2 mt-sm-0">
                                <small class="text-muted me-3"><i class="bi bi-clock me-1"></i>${date}</small>
                                ${actionBtnsHtml}
                            </div>
                        </div>
                        <div class="sec-info-box d-flex justify-content-between align-items-center flex-wrap my-3">
                            <div>
                                <span class="badge bg-purple mb-1">${sec}</span>
                                <span class="fw-bold ms-1 text-dark"><i class="bi bi-person-video3 me-1"></i>อ.${teacher}</span>
                                <p class="mb-0 text-muted" style="font-size: 0.85rem;"><i class="bi bi-calendar-event me-1"></i>วัน${day} | ⏰ ${start} - ${end} น.</p>
                            </div>
                            <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm mt-2 mt-sm-0" onclick="addToMySchedule('${code}', '${courseName}', '${sec}', '${teacher}', '${day}', '${start}', '${end}')">
                                <i class="bi bi-pin-angle-fill me-1"></i>เพิ่มลงตาราง
                            </button>
                        </div>
                        <p class="mb-0 text-break" style="white-space: pre-wrap;">${text}</p>
                    </div>`;
                }
            }
            if (!hasReview) reviewHtml = `<div class="text-center py-5"><p class="text-muted">ไม่มีข้อมูลที่ตรงกับตัวกรอง หรือยังไม่มีใครรีวิวครับ</p></div>`;
            document.getElementById('reviewsContainer').innerHTML = reviewHtml;
        }

        function setupEditReview(rowIndex, rating, text, semester, year, teacher, sec, day, start, end) {
            document.getElementById('reviewFormCollapse').classList.add('show');
            document.getElementById('editReviewRowIndex').value = rowIndex;
            document.getElementById('reviewRating').value = rating;
            document.getElementById('reviewText').value = text;
            document.getElementById('reviewSemester').value = semester;
            document.getElementById('reviewYear').value = year;
            document.getElementById('reviewTeacher').value = teacher;
            document.getElementById('reviewSec').value = sec;
            document.getElementById('reviewDay').value = day;
            document.getElementById('reviewStart').value = start;
            document.getElementById('reviewEnd').value = end;
            document.getElementById('reviewFormTitle').innerText = "✏️ แก้ไขข้อมูลของคุณ";
            document.getElementById('btnCancelEditReview').style.display = "block";
            document.getElementById('reviewFormCollapse').scrollIntoView({ behavior: 'smooth' });
        }

        function cancelEditReview() {
            document.getElementById('reviewForm').reset();
            document.getElementById('editReviewRowIndex').value = "";
            document.getElementById('btnCancelEditReview').style.display = "none";
            document.getElementById('reviewFormCollapse').classList.remove('show');
        }

        function handleReviewSubmit(e) {
            e.preventDefault();
            let btn = document.getElementById('btnSubmitReview');
            let originalText = btn.innerHTML;
            btn.disabled = true;

            let payload = {
                action: document.getElementById('editReviewRowIndex').value ? "updateReview" : "addReview",
                rowIndex: document.getElementById('editReviewRowIndex').value,
                courseCode: document.getElementById('reviewCourseCode').value,
                rating: document.getElementById('reviewRating').value,
                reviewText: document.getElementById('reviewText').value,
                semester: document.getElementById('reviewSemester').value,
                year: document.getElementById('reviewYear').value,
                teacher: document.getElementById('reviewTeacher').value,
                sec: document.getElementById('reviewSec').value,
                day: document.getElementById('reviewDay').value,
                start: document.getElementById('reviewStart').value,
                end: document.getElementById('reviewEnd').value,
                userEmail: currentUserEmail
            };

            postDataToAPI(payload, function(result) {
                btn.disabled = false;
                document.getElementById('reviewForm').reset();
                document.getElementById('reviewFormCollapse').classList.remove('show');
                loadData(function(){ renderReviews(); });
            }, btn, originalText);
        }

        function renderMyReviewsPage() {
            let reviews = globalData.reviews;
            let courses = globalData.courses;
            let container = document.getElementById('myReviewsList');
            let html = '';
            let hasReview = false;
            
            for (let i = reviews.length - 1; i >= 1; i--) {
                if (reviews[i][11] === globalData.currentUser && globalData.currentUser !== "") {
                    hasReview = true;
                    let rowIndex = i + 1;
                    let code = reviews[i][1];
                    let rating = reviews[i][2];
                    let text = reviews[i][3];
                    let semester = reviews[i][4] || "-";
                    let year = reviews[i][5] || "-";
                    let date = new Date(reviews[i][0]).toLocaleDateString('th-TH');
                    let stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
                    
                    let courseName = "ไม่ระบุชื่อวิชา";
                    for(let j = 1; j < courses.length; j++) {
                        if(courses[j][0] === code) { courseName = courses[j][1]; break; }
                    }
                    
                    html += `
                    <div class="col-md-6 mb-4">
                        <div class="review-box h-100 position-relative shadow-sm" style="border-radius: 16px;">
                            <h5 class="text-purple fw-bold mb-1">${code} <span class="fs-6 fw-normal text-muted">- ${courseName}</span></h5>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="star-rating">${stars}</span>
                                <span class="badge bg-light text-dark border">เทอม ${semester}/${year}</span>
                            </div>
                            <p class="text-break" style="font-size: 0.95rem; white-space: pre-wrap;">${text}</p>
                            <div class="d-flex justify-content-between align-items-end mt-4">
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>เขียนเมื่อ ${date}</small>
                                <button class="btn btn-sm btn-outline-danger px-3 rounded-pill" onclick="deleteData('Reviews', ${rowIndex}, true)">
                                    <i class="bi bi-trash-fill me-1"></i>ลบรีวิวนี้
                                </button>
                            </div>
                        </div>
                    </div>`;
                }
            }
            if (!hasReview) {
                html = `
                <div class="col-12 text-center py-5 my-5">
                    <i class="bi bi-chat-square-text" style="font-size: 5rem; color: var(--line);"></i>
                    <h4 class="mt-4 text-purple">คุณยังไม่เคยเขียนรีวิว</h4>
                    <p class="text-muted">ไปแชร์ประสบการณ์เรียนดีๆ ให้เพื่อนๆ ฟังกันเถอะ!</p>
                    <button class="btn btn-purple mt-3 px-4" onclick="showHomeView()">กลับไปเลือกวิชา</button>
                </div>`;
            }
            container.innerHTML = html;
        }

        // ====== ฟังก์ชันลบข้อมูล ======
        function deleteData(sheetName, rowIndex, isFromMyReviews = false) {
            if(confirm("แน่ใจหรือไม่ว่าต้องการลบข้อมูลนี้?")) {
                let payload = {
                    action: "deleteData",
                    sheetName: sheetName,
                    rowIndex: rowIndex,
                    userEmail: currentUserEmail
                };
                
                postDataToAPI(payload, function(result) {
                    loadData(function() {
                        if(isFromMyReviews) {
                            renderMyReviewsPage();
                        } else if(sheetName === 'Reviews') {
                            renderReviews();
                        } else {
                            courseModalInstance.hide();
                        }
                    });
                }, null, null);
            }
        }

        // ====== ระบบตารางเรียน (บันทึกในเครื่อง แยกตามอีเมล) ======
        function addToMySchedule(code, name, sec, teacher, day, start, end) {
            if(!day || !start || !end || start === "-" || end === "-") {
                alert("วิชานี้ไม่มีข้อมูลเวลาเรียนที่ชัดเจนครับ");
                return;
            }
            
            let scheduleKey = 'my_tu_schedule_' + currentUserEmail; // ผูกอีเมลไว้กับตารางเรียน
            let schedule = JSON.parse(localStorage.getItem(scheduleKey)) || [];
            let existingIndex = schedule.findIndex(s => s.code === code);
            
            if(existingIndex !== -1) {
                if(!confirm(`วิชา ${code} อยู่ในตารางเรียนแล้ว ต้องการเปลี่ยนเซคชั่นเป็น ${sec} ใช่ไหม?`)) return;
                schedule.splice(existingIndex, 1);
            }
            
            let conflict = schedule.find(s => s.day === day && ((start >= s.start && start < s.end) || (end > s.start && end <= s.end) || (start <= s.start && end >= s.end)));
            if(conflict) {
                alert(`❌ เวลาเรียนชนกัน!\nคุณมีเรียนวิชา ${conflict.code} ในวัน${day} เวลา ${conflict.start}-${conflict.end} น.`);
                return;
            }
            
            schedule.push({ code, name, sec, teacher, day, start, end });
            localStorage.setItem(scheduleKey, JSON.stringify(schedule)); // เซฟลงชื่อใหม่
            
            if(confirm(`✅ เพิ่ม ${code} ลงตารางเรียนแล้ว!\nต้องการไปดูหน้าตารางเรียนของคุณตอนนี้เลยไหม?`)) {
                reviewModalInstance.hide();
                showTimetableView();
            }
        }

        function renderTimetablePage() {
            let scheduleKey = 'my_tu_schedule_' + currentUserEmail; // ดึงตารางตามอีเมล
            let schedule = JSON.parse(localStorage.getItem(scheduleKey)) || [];
            let container = document.getElementById('timetableFullContent');
            
            if(schedule.length === 0) {
                container.innerHTML = `<div class="text-center py-5 my-5"><i class="bi bi-calendar-x" style="font-size: 5rem; color: var(--line);"></i><h4 class="mt-4 text-purple">ตารางเรียนยังว่างเปล่า</h4><p class="text-muted">กลับไปที่หน้าหลักแล้วกด "เพิ่มลงตาราง" ในรายละเอียดวิชากันเลย!</p><button class="btn btn-purple mt-3 px-4" onclick="showHomeView()">ไปเลือกวิชาเรียน</button></div>`;
                return;
            }
            
            const days = ["จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์", "อาทิตย์"];
            let headerHtml = '<div class="time-header-row">';
            for(let i = 8; i <= 19; i++) {
                let hour = i < 10 ? '0' + i : i;
                headerHtml += `<div class="time-header-slot">${hour}:00</div>`;
            }
            headerHtml += '</div>';
            
            let gridHtml = '';
            days.forEach(day => {
                let dayClasses = schedule.filter(s => s.day === day);
                gridHtml += `<div class="day-row">
                    <div class="day-label">${day}</div>
                    <div class="day-track">`;
                    
                dayClasses.forEach(c => {
                    let startParts = c.start.split(':'); let endParts = c.end.split(':');
                    let startMins = parseInt(startParts[0]) * 60 + parseInt(startParts[1]);
                    let endMins = parseInt(endParts[0]) * 60 + parseInt(endParts[1]);
                    
                    let tableStartMins = 8 * 60; let totalMins = 12 * 60;
                    if(startMins < tableStartMins) startMins = tableStartMins;
                    if(endMins > tableStartMins + totalMins) endMins = tableStartMins + totalMins;
                    
                    let leftPercent = ((startMins - tableStartMins) / totalMins) * 100;
                    let widthPercent = ((endMins - startMins) / totalMins) * 100;
                    let colorIndex = (c.code.charCodeAt(0) + c.code.charCodeAt(c.code.length-1)) % 6 + 1;
                    let originalIndex = schedule.findIndex(x => x.code === c.code && x.day === c.day);
                    
                    gridHtml += `
                    <div class="course-block color-${colorIndex}" style="left: ${leftPercent}%; width: ${widthPercent}%;" onclick="removeCourseFromSchedule(${originalIndex}, '${c.code}')" title="คลิกเพื่อลบวิชานี้">
                        <div class="c-title">${c.code} <span class="fw-normal opacity-75">(${c.sec})</span></div>
                        <div class="c-detail text-truncate">อ.${c.teacher}</div>
                        <div class="c-detail">${c.start}-${c.end}</div>
                    </div>`;
                });
                gridHtml += `</div></div>`;
            });
            
            container.innerHTML = `
            <div class="timetable-container">
                <div class="timetable-grid">
                    ${headerHtml}
                    ${gridHtml}
                </div>
            </div>`;
        }

        function removeCourseFromSchedule(index, code) {
            if(!confirm(`ต้องการลบวิชา ${code} ออกจากตารางเรียนใช่ไหม?`)) return;
            
            let scheduleKey = 'my_tu_schedule_' + currentUserEmail; // อ้างอิงตามอีเมล
            let schedule = JSON.parse(localStorage.getItem(scheduleKey)) || [];
            schedule.splice(index, 1);
            localStorage.setItem(scheduleKey, JSON.stringify(schedule));
            
            renderTimetablePage();
        }

        function clearSchedule() {
            if(confirm("คำเตือน: คุณต้องการล้างตารางเรียนทั้งหมดใช่หรือไม่?")) {
                let scheduleKey = 'my_tu_schedule_' + currentUserEmail; // อ้างอิงตามอีเมล
                localStorage.removeItem(scheduleKey);
                renderTimetablePage();
            }
        }
    </script>
</body>
</html>
