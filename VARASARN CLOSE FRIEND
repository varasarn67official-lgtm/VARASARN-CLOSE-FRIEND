<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Varasarn Close Friends</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --purple-900: #2A1B47;
            --purple-700: #6f42c1;
            --purple-600: #7c4fda;
            --purple-300: #c9b3f0;
            --purple-100: #f2ecfb;
            --purple-50: #fbf9ff;
            --amber-500: #f5a623;
            --ink-600: #5b5468;
            --line: #e7e1f5;
            --white: #ffffff;
            --radius-lg: 20px;
            --radius-md: 14px;
            --radius-pill: 999px;
            --shadow-card: 0 2px 10px rgba(111, 66, 193, 0.06);
            --shadow-card-hover: 0 16px 32px rgba(111, 66, 193, 0.18);
            --shadow-float: 0 10px 24px rgba(111, 66, 193, 0.30);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Prompt', sans-serif;
            background-color: var(--purple-50);
            color: var(--purple-900);
            font-weight: 300;
        }
        h1, h2, h3, h4, h5, h6 { font-family: 'Kanit', sans-serif; }
        .navbar-custom {
            background: linear-gradient(135deg, var(--purple-700) 0%, var(--purple-600) 100%);
            padding: 18px 0;
        }
        .navbar-brand {
            color: var(--white) !important;
            font-family: 'Kanit', sans-serif;
            font-weight: 600 !important;
            font-size: 1.35rem;
            cursor: pointer;
        }
        .user-dropdown-btn {
            background-color: rgba(255,255,255,0.18);
            padding: 6px 16px;
            border-radius: var(--radius-pill);
            color: var(--white);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.25);
            font-size: 0.85rem;
        }
        .user-dropdown-btn:hover, .user-dropdown-btn:focus {
            background-color: rgba(255,255,255,0.25);
            color: var(--white);
        }
        .dropdown-menu-custom {
            border-radius: 12px;
            border: 1px solid var(--line);
            box-shadow: var(--shadow-float);
        }
        .text-purple { color: var(--purple-700) !important; }
        .section-label {
            font-family: 'Kanit', sans-serif;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-label::before {
            content: "";
            display: inline-block;
            width: 10px; height: 10px;
            border-radius: 50% 50% 50% 0;
            background: var(--purple-700);
            transform: rotate(45deg);
        }
        .btn-purple {
            background-color: var(--purple-700);
            color: var(--white);
            border-radius: var(--radius-md);
            font-weight: 500;
            border: none;
        }
        .btn-purple:hover {
            background-color: var(--purple-600);
            color: var(--white);
        }
        .btn-outline-purple {
            color: var(--purple-700);
            border: 1.5px solid var(--purple-300);
            background-color: var(--white);
            font-weight: 400;
            border-radius: var(--radius-md);
        }
        .btn-outline-purple:hover {
            background-color: var(--purple-700);
            border-color: var(--purple-700);
            color: var(--white);
        }
        .search-wrap { position: relative; }
        .search-wrap .form-control {
            border: 1.5px solid var(--line);
            border-radius: var(--radius-pill);
            padding: 12px 20px 12px 46px;
        }
        .search-wrap .form-control:focus {
            border-color: var(--purple-700);
            box-shadow: 0 0 0 4px var(--purple-100);
        }
        .search-wrap .search-icon {
            position: absolute;
            left: 18px; top: 50%;
            transform: translateY(-50%);
            color: var(--purple-600);
            font-size: 1.1rem;
        }
        .category-menu {
            display: flex; overflow-x: auto; white-space: nowrap;
            padding-bottom: 12px; margin-bottom: 6px;
            -webkit-overflow-scrolling: touch;
        }
        .category-menu::-webkit-scrollbar { height: 5px; }
        .category-menu::-webkit-scrollbar-thumb {
            background-color: var(--purple-300);
            border-radius: var(--radius-pill);
        }
        .category-btn {
            margin-right: 8px; border-radius: var(--radius-pill) !important;
            padding: 7px 18px; font-size: 0.9rem; transition: all 0.2s;
        }
        .course-card {
            cursor: pointer; transition: all 0.2s;
            border: 1px solid var(--line); border-radius: var(--radius-lg);
            background-color: var(--white); box-shadow: var(--shadow-card);
            position: relative; overflow: hidden; height: 100%;
        }
        .course-card::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px;
            background: linear-gradient(90deg, var(--purple-700), var(--purple-600));
        }
        .course-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }
        .course-card .badge {
            background-color: var(--purple-100) !important;
            color: var(--purple-700) !important; font-weight: 500;
        }
        .course-card .card-title { font-family: 'Kanit', sans-serif; font-weight: 600; margin-top: 12px; }
        .course-card .card-text {
            color: var(--ink-600); font-size: 0.92rem; display: -webkit-box;
            -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        }
        .review-box {
            background: var(--white); border-radius: var(--radius-md);
            padding: 18px; margin-bottom: 12px; border: 1px solid var(--line);
            box-shadow: 0 2px 8px rgba(0,0,0,0.02); word-wrap: break-word;
        }
        .star-rating { color: var(--amber-500); font-weight: 500; letter-spacing: 2px; }
        .modal-content { border-radius: var(--radius-lg); border: none; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .modal-header.navbar-custom { padding: 20px 24px; }
        .modal-header.bg-light { background-color: var(--purple-50) !important; padding: 20px 24px; }
        .form-control, .form-select { border-radius: var(--radius-md); border: 1.5px solid var(--line); padding: 10px 14px; }
        .floating-contact-btn {
            position: fixed; bottom: 22px; right: 22px; z-index: 1050;
            border-radius: var(--radius-pill); padding: 14px 24px; box-shadow: var(--shadow-float); font-weight: 500;
        }
        .sec-info-box {
            background-color: var(--purple-50); border: 1px dashed var(--purple-300);
            border-radius: 8px; padding: 10px; font-size: 0.9rem;
        }
        /* Grid Timetable CSS */
        .timetable-container {
            overflow-x: auto; background: var(--white); border: 1px solid var(--line);
            border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-card);
        }
        .timetable-grid { min-width: 900px; position: relative; }
        .time-header-row {
            display: flex; margin-left: 60px; border-bottom: 1px solid var(--line);
            background: var(--purple-50); border-radius: 8px 8px 0 0;
        }
        .time-header-slot {
            flex: 1; text-align: left; font-size: 0.8rem; font-weight: 500;
            color: var(--purple-900); padding: 12px 6px; border-right: 1px dashed var(--line);
        }
        .day-row { display: flex; border-bottom: 1px solid var(--line); height: 85px; }
        .day-row:last-child { border-bottom: none; }
        .day-label {
            width: 60px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
            font-size: 0.9rem; font-weight: 600; border-right: 1px solid var(--line);
            background: var(--purple-50); color: var(--purple-900);
        }
        .day-track {
            flex-grow: 1; position: relative;
            background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
            background-size: calc(100% / 12) 100%;
        }
        .course-block {
            position: absolute; top: 10px; bottom: 10px; border-radius: 10px; padding: 8px 10px;
            overflow: hidden; display: flex; flex-direction: column; justify-content: center;
            line-height: 1.3; cursor: pointer; box-shadow: 0 3px 6px rgba(0,0,0,0.08);
            transition: transform 0.2s, z-index 0.2s, box-shadow 0.2s; z-index: 5; border: 1px solid rgba(0,0,0,0.05);
        }
        .course-block:hover { transform: scale(1.02); z-index: 10; box-shadow: 0 6px 12px rgba(0,0,0,0.15); }
        .course-block .c-title { font-family: 'Kanit', sans-serif; font-weight: 600; font-size: 0.9rem; margin-bottom: 3px; }
        .course-block .c-detail { font-size: 0.75rem; opacity: 0.9; }
        .color-1 { background: #e0e7ff; border-left: 5px solid #4f46e5; color: #312e81; }
        .color-2 { background: #fce7f3; border-left: 5px solid #db2777; color: #831843; }
        .color-3 { background: #d1fae5; border-left: 5px solid #059669; color: #064e3b; }
        .color-4 { background: #fef3c7; border-left: 5px solid #d97706; color: #78350f; }
        .color-5 { background: #dbeafe; border-left: 5px solid #2563eb; color: #1e3a8a; }
        .color-6 { background: #f3e8ff; border-left: 5px solid #9333ea; color: #581c87; }
    </style>
</head>
<body>
    <nav class="navbar navbar-custom navbar-dark mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="navbar-brand mb-0 h1" onclick="showHomeView()"><i class="bi bi-journal-text me-2"></i>Varasarn Close Friends</span>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-light text-purple fw-bold rounded-pill px-3 shadow-sm" onclick="showTimetableView()">
                    <i class="bi bi-grid-3x3-gap-fill me-1"></i>ตารางเรียน
                </button>
                <div class="dropdown d-none d-md-block">
                    <button class="btn user-dropdown-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span id="userEmailDisplay"><i class="bi bi-person-circle me-1"></i>กำลังโหลด...</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom py-2 mt-2">
                        <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="showMyReviewsView()"><i class="bi bi-star-fill text-warning me-2"></i>รีวิวของฉัน</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 text-danger fw-bold" href="javascript:void(0)" onclick="handleLogout()"><i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div id="homeView" class="container pb-5">
        <div class="d-md-none mb-3 text-end dropdown">
            <button class="btn user-dropdown-btn dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center" style="background-color: var(--purple-100); border-color: var(--purple-300); color: var(--purple-900);" type="button" data-bs-toggle="dropdown">
                <span id="userEmailDisplayMobile"><i class="bi bi-person-circle me-1"></i>กำลังโหลด...</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom w-100 py-2 mt-2">
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="showMyReviewsView()"><i class="bi bi-star-fill text-warning me-2"></i>รีวิวของฉัน</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 text-danger fw-bold" href="javascript:void(0)" onclick="handleLogout()"><i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ</a></li>
            </ul>
        </div>

        <div class="mb-4 mt-2 hero-banner"><img src="https://i.postimg.cc/FFk3NRHV/IMG-0677.jpg" class="img-fluid w-100" alt="Banner แนะนำรายวิชา" style="border-radius: var(--radius-lg);"></div>
        
        <!-- กล่องข้อความแจ้งจุดประสงค์เว็บ -->
        <div class="alert shadow-sm mb-4" style="background-color: var(--white); border: 1.5px solid var(--line); border-radius: var(--radius-lg);">
            <div class="text-center p-2 p-md-3">
                <h5 class="text-purple fw-bold mb-3"><i class="bi bi-info-circle-fill me-2"></i>เกี่ยวกับ Varasarn Close Friends</h5>
                <p class="mb-3" style="color: var(--ink-600); font-size: 0.95rem; line-height: 1.6;">
                    เว็บไซต์รวบรวมรีวิววิชาเรียนของคณะวารสารศาสตร์และสื่อสารมวลชน<br class="d-none d-md-block">
                    ทั้งหลักสูตรภาคปกติ (JC) และหลักสูตรนานาชาติ (BJM) เป็นพื้นที่รวบรวมความคิดเห็นจากนักศึกษา<br>
                    <span class="fw-bold" style="background-color: var(--purple-100); color: var(--purple-700); padding: 2px 10px; border-radius: 6px;">ดูแลโดยคณะกรรมการนักศึกษา (กน.วส.)</span>
                </p>
                <div class="d-inline-block px-4 py-2 mt-2" style="background-color: var(--purple-50); border-radius: var(--radius-pill); border: 1px dashed var(--purple-300);">
                    <small class="text-muted fw-medium"><i class="bi bi-headset me-1"></i>พบปัญหาหรือต้องการสอบถามติดต่อ</small>
                    <a href="https://www.instagram.com/varasarn.official" target="_blank" class="text-decoration-none fw-bold ms-2" style="background: -webkit-linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="bi bi-instagram me-1" style="color: #dc2743; -webkit-text-fill-color: initial;"></i>IG : varasarn.official
                    </a>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h4 class="mb-0 section-label">รายวิชาทั้งหมด</h4>
            <button class="btn btn-outline-purple shadow-sm" onclick="openCourseModal()"><i class="bi bi-plus-lg me-1"></i>เพิ่มรายวิชาใหม่</button>
        </div>

        <div class="mb-3 search-wrap">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="searchInput" class="form-control form-control-lg shadow-sm" placeholder="ค้นหารหัสวิชา หรือ ชื่อวิชา..." onkeyup="filterCourses()">
        </div>

        <div class="category-menu" id="categoryMenu">
            <button class="btn btn-purple category-btn" onclick="filterByCategory('ทั้งหมด', this)">ทั้งหมด</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาศึกษาทั่วไป', this)">วิชาศึกษาทั่วไป</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาแกนคณะ', this)">วิชาแกนคณะ</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาบังคับเลือกหมวด', this)">วิชาบังคับเลือกหมวด</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาวารสารศาสตร์', this)">กลุ่มวิชาวารสารศาสตร์</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาบริหารการสื่อสาร', this)">กลุ่มวิชาบริหารการสื่อสาร</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาวิทยุโทรทัศน์และสื่อดิจิทัล', this)">กลุ่มวิชาวิทยุโทรทัศน์ฯ</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาสื่อสารองค์กร', this)">กลุ่มวิชาสื่อสารองค์กร</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาโฆษณา', this)">กลุ่มวิชาโฆษณา</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('กลุ่มวิชาภาพยนตร์และภาพถ่าย', this)">กลุ่มวิชาภาพยนตร์ฯ</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาบังคับนอกคณะ', this)">วิชาบังคับนอกคณะ</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาโทหรือวิชาเลือก', this)">วิชาโทหรือวิชาเลือก</button>
            <button class="btn btn-outline-purple category-btn" onclick="filterByCategory('วิชาเลือกเสรี', this)">วิชาเลือกเสรี</button>
        </div>

        <div id="loading" class="text-center my-5"><div class="spinner-border text-purple" role="status"></div><p class="mt-3 fw-medium text-purple">กำลังโหลดข้อมูล...</p></div>
        <div class="row" id="courseList"></div>
    </div>

    <!-- หน้าต่างตารางเรียน -->
    <div id="timetableView" class="container pb-5" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="text-purple fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill me-2"></i>ตารางเรียนส่วนตัว</h3>
                <p class="text-muted mb-0 d-none d-md-block">My Timetable วางแผนการเรียนของคุณได้ง่ายๆ (คลิกที่วิชาเพื่อลบออก)</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-danger shadow-sm" onclick="clearSchedule()"><i class="bi bi-trash-fill me-1 d-none d-md-inline"></i>ล้างตาราง</button>
                <button class="btn btn-purple shadow-sm" onclick="showHomeView()"><i class="bi bi-arrow-left-circle-fill me-1"></i>หน้าหลัก</button>
            </div>
        </div>
        <div id="timetableFullContent"></div>
    </div>

    <!-- หน้าต่างรีวิวของฉัน -->
    <div id="myReviewsView" class="container pb-5" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="text-purple fw-bold mb-1"><i class="bi bi-star-fill text-warning me-2"></i>รีวิวของฉัน</h3>
                <p class="text-muted mb-0">จัดการรีวิวทั้งหมดที่คุณเคยเขียนไว้ที่นี่</p>
            </div>
            <button class="btn btn-purple shadow-sm" onclick="showHomeView()"><i class="bi bi-arrow-left-circle-fill me-1"></i>หน้าหลัก</button>
        </div>
        <div class="row" id="myReviewsList"></div>
    </div>

    <!-- Modal เพิ่มรายวิชา -->
    <div class="modal fade" id="courseModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light"><h5 class="modal-title text-purple" id="courseModalTitle">เพิ่มรายวิชาใหม่</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body p-4">
                    <form id="courseForm" onsubmit="handleCourseSubmit(event)">
                        <input type="hidden" id="courseRowIndex">
                        <div class="mb-3"><label>รหัสวิชา</label><input type="text" class="form-control" id="newCourseCode" required></div>
                        <div class="mb-3"><label>ชื่อวิชา</label><input type="text" class="form-control" id="newCourseName" required></div>
