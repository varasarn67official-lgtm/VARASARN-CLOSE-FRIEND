        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-light px-4 py-3"><h5 class="modal-title text-purple"><i class="bi bi-headset me-2"></i>ติดต่อผู้ดูแล</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body text-center p-4">
                    <a href="https://line.me/R/ti/p/@293shldn" target="_blank" class="btn w-100 mb-3 text-white fw-bold d-flex align-items-center justify-content-center" style="background-color: #00B900; border-radius: 12px; padding: 12px;"><i class="bi bi-line fs-5 me-2"></i>ติดต่อทาง LINE</a>
                    <a href="https://www.instagram.com/varasarn_official?igsh=MWpxa2V4YWlzaXF3YQ==" target="_blank" class="btn w-100 text-white fw-bold d-flex align-items-center justify-content-center" style="background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); border-radius: 12px; padding: 12px;"><i class="bi bi-instagram fs-5 me-2"></i>ทักแชททาง IG</a>
