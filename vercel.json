{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?authPath=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci"
}
