# Browser-safe endpoints only. Do not place database, management, or OAuth secrets here.
VITE_NEON_AUTH_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-data-api-endpoint

# CLI only; never prefix this with VITE_ or deploy it as a browser variable.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
